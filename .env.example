# ────────────────────────────────────────────────────
# MacroIntel Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# ────────────────────────────────────────────────────

# App
APP_NAME=MacroIntel
ENVIRONMENT=development
DEBUG=false

# Database (update for production)
DATABASE_URL=postgresql+asyncpg://macrointel:macrointel@localhost:5432/macrointel
DATABASE_SYNC_URL=postgresql://macrointel:macrointel@localhost:5432/macrointel

# Redis
REDIS_URL=redis://localhost:6379/0

# Security — CHANGE IN PRODUCTION
SECRET_KEY=your-secret-key-minimum-32-characters-here

# ────────────────────────────────────────────────────
# Data API Keys
# ────────────────────────────────────────────────────

# FRED API (free — register at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Alpha Vantage (free tier — https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Trading Economics (optional, for PMI and global indicators)
# https://tradingeconomics.com/api/
TRADING_ECONOMICS_API_KEY=
TRADING_ECONOMICS_API_SECRET=

# ────────────────────────────────────────────────────
# Frontend
# ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
